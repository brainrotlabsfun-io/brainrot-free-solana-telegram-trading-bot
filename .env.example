# ─────────────────────────────────────────────────────────────────────────────
#  Environment configuration
#
#  1. Copy this file to `.env`     ->  cp .env.example .env
#  2. Fill in the REQUIRED values below.
#  3. Never commit `.env` — it is gitignored for a reason.
#
#  Every value here must be YOUR OWN. Do not reuse keys, tokens, wallets or
#  RPC URLs from any other repository, tutorial, or fork.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ REQUIRED ════════════════════════════════════════════════════════════════

# ── Telegram bot token ───────────────────────────────────────────────────────
# Open Telegram, message @BotFather, send /newbot, follow the prompts.
# He replies with a token that looks like:  1234567890:AAExampleTokenString
# Treat it like a password — anyone with it controls your bot.
BOT_TOKEN=

# ── Wallet encryption key ────────────────────────────────────────────────────
# Encrypts every user's bot-wallet private key before it is stored in the DB.
# Generate your OWN key (run this, paste the output here):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# WARNING: if you lose or change this key, every wallet in your database
# becomes permanently unreadable. Back it up. Never share it, never commit it.
WALLET_ENCRYPTION_KEY=


# ═══ STRONGLY RECOMMENDED ════════════════════════════════════════════════════

# ── Solana RPC ───────────────────────────────────────────────────────────────
# The default public endpoint works but rate-limits hard (HTTP 429), which
# makes balance checks return 0 and trades fail. Get a free key instead:
#   Helius    https://helius.dev      (free tier, no card)
#   QuickNode https://quicknode.com
#   Triton    https://triton.one
# Then use your own URL, e.g.
#   https://mainnet.helius-rpc.com/?api-key=YOUR_OWN_KEY_HERE
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: comma-separated list. The bot round-robins these and skips any
# endpoint that returns 429 for a short cooldown. Include your paid one first.
# SOLANA_RPC_URLS=https://mainnet.helius-rpc.com/?api-key=YOUR_OWN_KEY,https://api.mainnet-beta.solana.com

# ── Admin access ─────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs allowed to run admin commands.
# Find yours: start your bot and send /myid (or message @userinfobot).
# Leave blank and NOBODY has admin rights.
ADMIN_IDS=


# ═══ OPTIONAL — branding & links ═════════════════════════════════════════════
# These drive share buttons and referral links. Blank values simply hide the
# corresponding button, so the bot works fine with none of them set.

# Your bot's @username, without the @ (BotFather told you this at creation).
BOT_USERNAME=

# Shown in share/marketing copy, e.g. @myproject
BRAND_HANDLE=

# Display name for your token in bot copy, e.g. MYTOKEN
TOKEN_NAME=TOKEN

# Hashtag appended to share posts, e.g. #myproject
SHARE_HASHTAG=

# Community links — each one is a button; blank hides it.
DISCORD_URL=
TWITTER_URL=
WEBSITE_URL=


# ═══ OPTIONAL — token gating & payments ══════════════════════════════════════
# Leave these blank unless you actually run a token / paid tier.

# Your SPL token mint address. Blank disables all token-gating and burn features.
BRAINROT_MINT=

# SOL address that RECEIVES subscription and signup payments.
# This MUST be a wallet you control. Blank disables paid features entirely.
PAYMENT_WALLET=

# Private key (base58) of the wallet that SENDS affiliate commissions.
# Only needed if you enable automatic payouts. This key can move real funds —
# use a dedicated hot wallet with a limited balance, never your main wallet.
PAYMENT_WALLET_PRIVATE_KEY=

# SOL amount treated as the qualifying paid signup. Update as SOL price moves.
AFFILIATE_SIGNUP_SOL=0.67

# Local testing only — simulates a confirmed payment without real SOL.
# NEVER set this to true in production.
MOCK_SUPREME_PAYMENT_CONFIRMATION=false

# Token amounts required to unlock premium tiers via burning.
# SUPREME_REQUIRED_BURN_AMOUNT=1000000
# SUPREME_BLACK_REQUIRED_BURN_AMOUNT=10000000


# ═══ OPTIONAL — behaviour tuning ═════════════════════════════════════════════

# true  = raids go live immediately;  false = admin must /approve_raid first
RAID_AUTO_APPROVE=true
DAILY_RAID_LIMIT=2
PREMIUM_DAILY_RAID_LIMIT=10
